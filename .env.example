# Optional. For a physical phone, use this computer's LAN IPv4 address.
# The app normally derives it automatically from Expo Go's development host.
EXPO_PUBLIC_API_URL=http://192.168.1.42:4000

# The mock server listens on every local interface by default.
CONTROL_SERVER_HOST=0.0.0.0
CONTROL_SERVER_PORT=4000

# ─── Deriv WebSocket API (Phase 2 — Market Profiler) ─────────────────────────
# Leave DERIV_APP_ID as 1089 for the public demo app_id (no registration needed).
# Create your own at https://app.deriv.com/account/api-token for production.
DERIV_APP_ID=1089

# Optional. A read-only API token enables authenticated profiling.
# Generate at: app.deriv.com/account/api-token  →  select "Read" scope only.
# NEVER commit this file with a real token. Add .env to .gitignore.
# NEVER store write-access or trading tokens in this file or the mobile app.
DERIV_API_TOKEN=
