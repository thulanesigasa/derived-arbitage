{
  "name": "mobile-ea-controller-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --raw \"npm:server:dev\" \"npm:expo:start\"",
    "dev:win": "powershell -Command \"Start-Process powershell -ArgumentList '-NoExit','-Command','cd \\\"$PWD\\\"; npx expo start --lan --port 8082' -WindowStyle Normal; npm run server:dev\"",
    "expo:start": "expo start --lan --port 8082",
    "server:dev": "tsx watch server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
    "typecheck": "npm run typecheck:app && npm run typecheck:server",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "cors": "latest",
    "dotenv": "latest",
    "expo": "latest",
    "expo-constants": "latest",
    "expo-status-bar": "latest",
    "express": "latest",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/ws": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "~6.0.3",
    "vitest": "latest"
  }
}
